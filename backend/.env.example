# 复制本文件为 backend/.env 后填入真实值；backend/.env 已被 .gitignore 忽略，不会进仓库。
# 真实 Key 只在 backend/.env 里填，不要写进代码、对话、日志、截图或提交记录。

# DeepSeek 官方 API（OpenAI 兼容接口）
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT=120

# 本地数据目录（相对 backend/ 的路径；默认 ../data）
DATA_DIR=../data
